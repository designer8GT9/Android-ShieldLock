<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Android 11+ oculta las demás apps: sin esto no se puede saber si Shizuku está instalado -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="af.shizuku.plus.api" />
    </queries>

    <!-- allowBackup en false: así el hash de la tercera contraseña no sale en copias de seguridad.
         Se quitaron dataExtractionRules y fullBackupContent porque con el backup apagado no hacen falta. -->
    <application
        android:allowBackup="false"
        android:localeConfig="@xml/locales_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ShieldLock">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Guarda el idioma elegido en Android 12 e inferior (AppCompat) -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- Guía para el usuario -->
        <activity
            android:name=".GuiaActivity"
            android:exported="false" />

        <!-- Contraseña calculadora (4ª): vertical y en la misma tarea que la pantalla de bloqueo -->
        <activity
            android:name=".CalculadoraActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:taskAffinity="${applicationId}.lock" />

        <!-- Pantalla de bloqueo (PIN de la hora + tercera contraseña).
             Task propia: al terminar, el usuario vuelve a la app que estaba usando y no a los ajustes de ShieldLock.
             configChanges: girar la pantalla no reinicia la canción. -->
        <activity
            android:name=".LockActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.lock"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize" />

        <!-- Shizuku (opcional): con este provider Shizuku le entrega su conexión a la app.
             El permiso de INTERACT_ACROSS_USERS_FULL evita que apps normales lo usen. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Administrador del dispositivo (permite bloquear la pantalla y, en modo máximo, ser Device Owner) -->
        <receiver
            android:name=".AdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Arranque: se ejecuta al reiniciar el teléfono (después de que el usuario lo desbloquea)
             y cuando la app se actualiza, para volver a activar la protección. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Guardián: vigila el desbloqueo y abre la pantalla de bloqueo -->
        <service
            android:name=".GuardService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Vigila el desbloqueo del teléfono para pedirle al usuario su PIN de seguridad" />
        </service>

        <!-- Servicio de accesibilidad -->
        <service
            android:name=".GuardAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>
    </application>

</manifest>